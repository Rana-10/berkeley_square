{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/lib/**/*.ts", "src/schema/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
